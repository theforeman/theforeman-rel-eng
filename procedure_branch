#!/bin/bash -e

. settings

TARGET_DATE="$1"
OWNER="$2"
ENGINEER="$3"

if [[ -z $TARGET_DATE ]] ; then
	read -r -p "Target date (YYYY-MM-DD): " TARGET_DATE
	READ=1
fi
if [[ -z $OWNER ]] ; then
	read -r -p "Release owner (Discourse username): " OWNER
	READ=1
fi
if [[ -z $ENGINEER ]] ; then
	read -r -p "Release engineer (Discourse username): " ENGINEER
	READ=1
fi
if [[ $PROJECT == foreman && -z $KATELLO_VERSION ]] ; then
	read -r -p "Paired Katello version (X.Y): " KATELLO_VERSION
	READ=1
fi
if [[ $READ == 1 ]] ; then
	echo >&2
fi

args=(branch --project "$PROJECT" --release "$VERSION" --target-date "$TARGET_DATE" --owner "$OWNER" --engineer "$ENGINEER")
if [[ $PROJECT == foreman ]] ; then
	args+=(--katello-version "$KATELLO_VERSION")
fi
./procedure "${args[@]}"
