#!/bin/bash -e

. settings

require_fullversion

REPO="${PROJECT}-oci-images"
CONTAINERFILE="images/${PROJECT}/Containerfile"

BRANCHES=$(./candlepin_oci_branches)

cd "$OCI_DIR"

if [[ $PACKAGING_PR == true ]] ; then
  # Only fork if it doesn't exist yet
  if ! gh repo view "${GITHUB_USER}/${REPO}" --json url --jq .url &>/dev/null ; then
    GH_PROMPT_DISABLED=1 gh repo fork "${GITHUB_NAMESPACE}/${REPO}" --remote-name "$OCI_FORK_REMOTE"
  fi

  if ! git remote get-url "$OCI_FORK_REMOTE" &>/dev/null ; then
    git remote add "$OCI_FORK_REMOTE" "$(github_url "$REPO")"
  fi
fi

FAILED=()

for branch in $BRANCHES; do
  FEATURE_BRANCH="bump-candlepin-${FULLVERSION}-${branch//\//-}"

  if [[ $PACKAGING_PR == true ]] && gh pr list --repo "${GITHUB_NAMESPACE}/${REPO}" \
       --head "${GITHUB_USER}:${FEATURE_BRANCH}" --state open --json number --jq 'length > 0' \
       | grep -q true ; then
    echo "$branch: PR already open for $FEATURE_BRANCH, skipping" >&2
    continue
  fi

  git checkout -B "$FEATURE_BRANCH" "$OCI_GIT_REMOTE/$branch"

  sed -i "s/^ARG VERSION_XYZ=.*/ARG VERSION_XYZ=${FULLVERSION}/" "$CONTAINERFILE"
  sed -i "s/^PROJECT_XY_TAG=.*/PROJECT_XY_TAG=${VERSION}/" Makefile
  sed -i "s/^PROJECT_XYZ_TAG=.*/PROJECT_XYZ_TAG=${FULLVERSION}/" Makefile

  if git diff --quiet -- "$CONTAINERFILE" || git diff --quiet -- Makefile ; then
    echo "$branch: sed made no change in $CONTAINERFILE or Makefile, skipping" >&2
    FAILED+=("$branch")
    continue
  fi

  git add "$CONTAINERFILE" Makefile
  git commit --message "Bump ${PROJECT^} to $FULLVERSION"

  if [[ $PACKAGING_PR == true ]] ; then
    git push --set-upstream "$OCI_FORK_REMOTE" "$FEATURE_BRANCH"

    gh pr create --repo "${GITHUB_NAMESPACE}/${REPO}" \
                 --title "Bump ${PROJECT^} to $FULLVERSION" \
                 --head "$GITHUB_USER:$FEATURE_BRANCH" \
                 --base "$branch" \
                 --body "Bump ${PROJECT^} to $FULLVERSION"
  else
    git push "$OCI_GIT_REMOTE" "HEAD:$branch"
  fi
done

if [[ ${#FAILED[@]} -gt 0 ]] ; then
  echo "Failed to bump: ${FAILED[*]}" >&2
  exit 1
fi
