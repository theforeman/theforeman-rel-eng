#!/usr/bin/env python3

from base64 import b64decode
from binascii import Error as Base64Error
from subprocess import DEVNULL, PIPE, run
import argparse
import glob


def find_unsigned_packages(target_dir, gpgkey):
    packages = glob.glob(f"{target_dir}/*.rpm")

    for package in packages:
        # RPM 4.19+ stores the V4 OpenPGP signature outside the legacy
        # SIGPGP query tag.  Read the OPENPGP tag and inspect its detached
        # signature packet instead.  This does not need the release public
        # key in rpm's global database.
        encoded_signature = run(
            ['rpm', '--query', '--queryformat', '%{OPENPGP}', package],
            stdout=PIPE,
            stderr=DEVNULL,
            check=False,
        ).stdout.strip()

        try:
            signature = b64decode(encoded_signature, validate=True)
        except Base64Error:
            signature = None

        if not signature:
            # RHEL/CentOS 9's RPM does not expose the OPENPGP tag.  Retain
            # the legacy tag check for that implementation.
            output = run(
                ['rpm', '--query', '--queryformat', '%{SIGPGP:pgpsig}', package],
                universal_newlines=True,
                stdout=PIPE,
                stderr=DEVNULL,
                check=False,
            ).stdout
        else:
            output = run(
                ['gpg2', '--batch', '--list-packets'],
                input=signature,
                stdout=PIPE,
                stderr=DEVNULL,
                check=False,
            ).stdout.decode(errors='replace')

        if gpgkey.lower() not in output.lower():
            yield package


def handle_args():
    parser = argparse.ArgumentParser(description='Sign unsigned RPMs in local stage repository')
    parser.add_argument(
        'repository_path',
        help='Path to repository to sign unsigned RPMs'
    )
    parser.add_argument(
        'gpgkey',
        help='Short form gpgkey for the version being generated'
    )

    args = parser.parse_args()

    if len(args.gpgkey) != 16:
        raise SystemExit("GPG key must be the last 16 characters")

    return args


def main():
    args = handle_args()

    repository_path = args.repository_path
    gpgkey = args.gpgkey

    for rpm in find_unsigned_packages(repository_path, gpgkey):
        print(rpm)


if __name__ == '__main__':
    main()
