#!/bin/bash -e

. settings

REPO="${PROJECT}-oci-images"
CONTAINERFILE=images/candlepin/Containerfile

if [[ ! -d "$OCI_DIR" ]] ; then
  git clone --quiet --origin "$OCI_GIT_REMOTE" "$(github_url "$REPO")" "$OCI_DIR"
fi

git -C "$OCI_DIR" fetch --prune --quiet "$OCI_GIT_REMOTE"

found=false
while read -r branch; do
  case "$branch" in
    HEAD|dependabot/*|konflux/*|use-*) continue ;;
  esac

  content=$(git -C "$OCI_DIR" show "$OCI_GIT_REMOTE/$branch:$CONTAINERFILE" 2>/dev/null) || continue

  if echo "$content" | grep -qFx "ARG VERSION=${VERSION}"; then
    echo "$branch"
    found=true
  fi
done < <(git -C "$OCI_DIR" branch --remotes --list "$OCI_GIT_REMOTE/*" --format='%(refname:lstrip=3)')

if [[ $found == false ]]; then
  echo "No $OCI_GIT_REMOTE branch of $REPO has 'ARG VERSION=${VERSION}' in $CONTAINERFILE." >&2
  echo "Check VERSION is correct; if it is, the version isn't published anywhere yet." >&2
  exit 1
fi
